@page
@model LibrairieReservation.Pages.Livres.IndexModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<h2>Gestion des Livres</h2>

@if (!string.IsNullOrEmpty(Model.MessageErreur))
{
    <div class="alert alert-danger">@Model.MessageErreur</div>
}
@if (!string.IsNullOrEmpty(Model.MessageSucces))
{
    <div class="alert alert-success">@Model.MessageSucces</div>
}

<button class="btn btn-primary mb-3" data-bs-toggle="modal" data-bs-target="#livreModal" onclick="openModal()">Ajouter un livre</button>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Titre</th>
            <th>Auteur</th>
            <th>ISBN</th>
            <th>Maison d'édition</th>
            <th>Année de publication</th>
            <th>Nombre de pages</th>
            <th>Langue</th>
            <th>Stock</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var livre in Model.Livres)
        {
            <tr>
                <td>@livre.Titre</td>
                <td>@livre.Auteur.Nom</td>
                <td>@(string.IsNullOrEmpty(livre.ISBN) ? "-" : livre.ISBN)</td>
                <td>@(string.IsNullOrEmpty(livre.MaisonEdition) ? "-" : livre.MaisonEdition)</td>
                <td>@livre.AnneePublication</td>
                <td>@livre.NombrePages</td>
                <td>@(string.IsNullOrEmpty(livre.Langue) ? "-" : livre.Langue)</td>
                <td>@livre.Stock</td>
                <td>
                    <button class="btn btn-sm btn-info"
                            onclick="editLivre(@livre.Id,
                                                '@livre.Titre.Replace("'", "\\'")',
                                                @livre.AuteurId,
                                                '@(livre.ISBN?.Replace("'", "\\'") ?? "")',
                                                '@(livre.MaisonEdition?.Replace("'", "\\'") ?? "")',
                                                @livre.AnneePublication,
                                                @livre.NombrePages,
                                                '@(livre.Langue?.Replace("'", "\\'") ?? "")',
                                                @livre.Stock)">
                        Modifier
                    </button>
                    <form method="post" asp-page-handler="Delete" asp-route-id="@livre.Id" style="display:inline"
                          onsubmit="return confirm('Voulez-vous vraiment supprimer ce livre ?');">
                        <button type="submit" class="btn btn-sm btn-danger">Supprimer</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="modal fade" id="livreModal" tabindex="-1" aria-labelledby="livreModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <form method="post" asp-page-handler="CreateOrEdit">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="livreModalLabel">Ajouter / Modifier un livre</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" asp-for="Livre.Id" id="LivreId" />

                    <div class="mb-3">
                        <label asp-for="Livre.Titre" class="form-label"></label>
                        <input asp-for="Livre.Titre" class="form-control" />
                        <span asp-validation-for="Livre.Titre" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Livre.AuteurId" class="form-label"></label>
                        <select asp-for="Livre.AuteurId" class="form-control" asp-items="Model.AuteursSelectList">
                            <option value="">-- Sélectionner un auteur --</option>
                        </select>
                        <span asp-validation-for="Livre.AuteurId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Livre.ISBN" class="form-label"></label>
                        <input asp-for="Livre.ISBN" class="form-control" />
                        <span asp-validation-for="Livre.ISBN" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Livre.MaisonEdition" class="form-label"></label>
                        <input asp-for="Livre.MaisonEdition" class="form-control" />
                        <span asp-validation-for="Livre.MaisonEdition" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Livre.AnneePublication" class="form-label"></label>
                        <input asp-for="Livre.AnneePublication" class="form-control" type="number" />
                        <span asp-validation-for="Livre.AnneePublication" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Livre.NombrePages" class="form-label"></label>
                        <input asp-for="Livre.NombrePages" class="form-control" type="number" />
                        <span asp-validation-for="Livre.NombrePages" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Livre.Langue" class="form-label"></label>
                        <input asp-for="Livre.Langue" class="form-control" />
                        <span asp-validation-for="Livre.Langue" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Livre.Stock" class="form-label"></label>
                        <input asp-for="Livre.Stock" class="form-control" type="number" />
                        <span asp-validation-for="Livre.Stock" class="text-danger"></span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-primary">Enregistrer</button>
                </div>
            </div>
        </form>
    </div>
</div>

<partial name="_ValidationScriptsPartial" />

<script>
    function openModal() {
        clearForm();
        var myModal = new bootstrap.Modal(document.getElementById('livreModal'));
        myModal.show();
    }

    function editLivre(id, titre, auteurId, isbn, maisonEdition, anneePublication, nombrePages, langue, stock) {
        clearForm();

        document.getElementById('LivreId').value = id;
        document.getElementById('Livre_Titre').value = titre;
        document.getElementById('Livre_AuteurId').value = auteurId;
        document.getElementById('Livre_ISBN').value = isbn;
        document.getElementById('Livre_MaisonEdition').value = maisonEdition;
        document.getElementById('Livre_AnneePublication').value = anneePublication;
        document.getElementById('Livre_NombrePages').value = nombrePages;
        document.getElementById('Livre_Langue').value = langue;
        document.getElementById('Livre_Stock').value = stock;

        var myModal = new bootstrap.Modal(document.getElementById('livreModal'));
        myModal.show();
    }

    function clearForm() {
        document.getElementById('LivreId').value = 0;
        document.getElementById('Livre_Titre').value = '';
        document.getElementById('Livre_AuteurId').value = ''; // Clear selected option
        document.getElementById('Livre_ISBN').value = '';
        document.getElementById('Livre_MaisonEdition').value = '';
        document.getElementById('Livre_AnneePublication').value = '';
        document.getElementById('Livre_NombrePages').value = '';
        document.getElementById('Livre_Langue').value = '';
        document.getElementById('Livre_Stock').value = '';
    }
</script>