@page
@model LibrairieReservation.Pages.Livres.CreateModel

<h1>Ajouter un Livre</h1>

<form method="post">
    <label>Titre :</label>
    <input asp-for="Livre.Titre" />
    <span asp-validation-for="Livre.Titre"></span>
    <br />

    <label>Auteur :</label>
    <input asp-for="Livre.Auteur" />
    <span asp-validation-for="Livre.Auteur"></span>
    <br />

    <label>Stock :</label>
    <input asp-for="Livre.Stock" type="number" />
    <span asp-validation-for="Livre.Stock"></span>
    <br />

    <button type="submit">Ajouter</button>
</form>

<a asp-page="Index">Retour à la liste</a>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
