@page
@model LibrairieReservation.Pages.Auteurs.IndexModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<h2>Gestion des Auteurs</h2>

@if (!string.IsNullOrEmpty(Model.MessageErreur))
{
    <div class="alert alert-danger">@Model.MessageErreur</div>
}
@if (!string.IsNullOrEmpty(Model.MessageSucces))
{
    <div class="alert alert-success">@Model.MessageSucces</div>
}

<button class="btn btn-primary mb-3" data-bs-toggle="modal" data-bs-target="#authorModal" onclick="openModal()">Ajouter un auteur</button>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Nom</th>
            <th>Nationalit�</th>
            <th>Biographie</th>
            <th>Nombre de livres</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var auteur in Model.Auteurs)
        {
            <tr>
                <td>@auteur.Nom</td>
                <td>@auteur.Nationalite</td>
                <td>@(string.IsNullOrEmpty(auteur.Biographie) ? "-" : auteur.Biographie)</td>
                @if (auteur.Livres != null)
                {
                    <td>@auteur.Livres.Count</td>
                }
                else
                {
                    <td>0</td>
                }
                <td>
                    <button class="btn btn-sm btn-info" 
                            onclick="editAuteur(@auteur.Id, '@auteur.Nom.Replace("'", "\\'")', '@auteur.Nationalite.Replace("'", "\\'")', '@auteur.Biographie?.Replace("'", "\\'")')">
                        Modifier
                    </button>
                    <form method="post" asp-page-handler="Delete" asp-route-id="@auteur.Id" style="display:inline"
                          onsubmit="return confirm('Voulez-vous vraiment supprimer cet auteur ?');">
                        <button type="submit" class="btn btn-sm btn-danger">Supprimer</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Modal Bootstrap pour ajout / modification -->
<div class="modal fade" id="authorModal" tabindex="-1" aria-labelledby="authorModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <form method="post" asp-page-handler="CreateOrEdit">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="authorModalLabel">Ajouter / Modifier un auteur</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" asp-for="Auteur.Id" id="AuteurId" />

                    <div class="mb-3">
                        <label asp-for="Auteur.Nom" class="form-label"></label>
                        <input asp-for="Auteur.Nom" class="form-control" />
                        <span asp-validation-for="Auteur.Nom" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Auteur.Nationalite" class="form-label"></label>
                        <input asp-for="Auteur.Nationalite" class="form-control" />
                        <span asp-validation-for="Auteur.Nationalite" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Auteur.Biographie" class="form-label"></label>
                        <textarea asp-for="Auteur.Biographie" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="Auteur.Biographie" class="text-danger"></span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-primary">Enregistrer</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function openModal() {
            clearForm();
            var myModal = new bootstrap.Modal(document.getElementById('authorModal'));
            myModal.show();
        }

        function editAuteur(id, nom, nationalite, biographie) {
            clearForm();

            document.getElementById('AuteurId').value = id;
            document.getElementById('Auteur_Nom').value = nom;
            document.getElementById('Auteur_Nationalite').value = nationalite;
            document.getElementById('Auteur_Biographie').value = biographie;

            var myModal = new bootstrap.Modal(document.getElementById('authorModal'));
            myModal.show();
        }

        function clearForm() {
            document.getElementById('AuteurId').value = 0;
            document.getElementById('Auteur_Nom').value = '';
            document.getElementById('Auteur_Nationalite').value = '';
            document.getElementById('Auteur_Biographie').value = '';
        }
    </script>
}
